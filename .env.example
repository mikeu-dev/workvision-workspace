# ==============================================================================
# WORKVISION AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini ke .env dan sesuaikan nilainya: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APLIKASI & ENVIRONMENT
# ------------------------------------------------------------------------------
APP_NAME="WorkVision AI"
APP_ENV=development                # development | staging | production
DEBUG=true
TIMEZONE=Asia/Jakarta

# ------------------------------------------------------------------------------
# 2. DATABASE POSTGRESQL (DOCKER / LOCAL)
# ------------------------------------------------------------------------------
POSTGRES_USER=workvision
POSTGRES_PASSWORD=workvision_secret_2026
POSTGRES_DB=workvision_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Async SQLAlchemy Connection URL
DATABASE_URL=postgresql+asyncpg://workvision:workvision_secret_2026@localhost:5432/workvision_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ------------------------------------------------------------------------------
# 3. REDIS MESSAGE BROKER & STREAM
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
STREAM_VISION_EVENTS=stream:vision:events
STREAM_ATTENDANCE_EVENTS=stream:attendance:events
STREAM_SYSTEM_HEALTH=stream:system:health

# ------------------------------------------------------------------------------
# 4. VISION WORKER & AI INFERENCE
# ------------------------------------------------------------------------------
# Model Path (YOLOv8/v11 weights)
YOLO_MODEL_PATH=models/detection/yolov8n.pt

# Device inference: 'cuda:0' (NVIDIA GPU) atau 'cpu'
INFERENCE_DEVICE=cuda:0
CONFIDENCE_THRESHOLD=0.50
IOU_THRESHOLD=0.45
INFERENCE_FPS=10                   # Frame rate sampling untuk inferensi
MAX_FRAME_QUEUE_SIZE=1             # Drop-oldest queue policy (zero latency creep)

# ------------------------------------------------------------------------------
# 5. BYTETRACK TRACKING PARAMETERS
# ------------------------------------------------------------------------------
TRACK_HIGH_THRESH=0.60
TRACK_LOW_THRESH=0.10
NEW_TRACK_THRESH=0.70
MATCH_THRESH=0.80
TRACK_BUFFER=30                    # Buffer frame untuk mempertahankan track yang hilang sejenak

# ------------------------------------------------------------------------------
# 6. TEMPORAL STATE MACHINE & HYSTERESIS FILTER
# ------------------------------------------------------------------------------
STATE_DEBOUNCE_SECONDS=30          # Durasi konsistensi minimum sebelum transisi state
AWAY_TIMEOUT_SECONDS=300           # Durasi track lost/tidak terdeteksi sebelum dianggap AWAY
BREAK_MIN_SECONDS=180              # Durasi minimum di Pantry/Lounge sebelum dianggap BREAK
MEETING_MIN_SECONDS=120            # Durasi minimum di Meeting Room sebelum dianggap MEETING

# ------------------------------------------------------------------------------
# 7. SECURITY, ENCRYPTION & UU PDP COMPLIANCE
# ------------------------------------------------------------------------------
# Kunci simetris AES-256 untuk enkripsi vektor biometrik wajah & Re-ID di database
BIOMETRIC_ENCRYPTION_KEY=workvision_biometric_aes256_super_secret_key_change_in_production_32chars!

# JWT Secret untuk otentikasi API
JWT_SECRET_KEY=workvision_jwt_secret_change_in_production_key_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 8. API & WEBSOCKET GATEWAY
# ------------------------------------------------------------------------------
# Host interface & port (mendukung alias HOST dan PORT untuk PaaS/cloud deployment)
API_HOST=0.0.0.0
API_PORT=8000
# HOST=0.0.0.0
# PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
